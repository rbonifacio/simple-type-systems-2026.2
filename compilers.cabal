cabal-version:      3.0
name:               compilers
version:            0.1.0.0
synopsis:           Semantica operacional small-step de AE e LC
author:             rbonifacio
maintainer:         rbonifacio123@gmail.com
build-type:         Simple
extra-doc-files:    DOCUMENTACAO.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  AE
                    , LC
    build-depends:    base >=4 && <5
                    , containers
    hs-source-dirs:   lib
    default-language: Haskell2010

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:    AESpec
                    , LCSpec
    build-depends:    base >=4 && <5
                    , containers
                    , hspec
                    , compilers
    build-tool-depends: hspec-discover:hspec-discover
    hs-source-dirs:   test
    default-language: Haskell2010
